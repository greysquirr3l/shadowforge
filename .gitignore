# Project-specific ignores - Ignore first, then explicit allow

# Ignore entire docs/ directory
docs/

# Explicitly allow public documentation
!docs/public/
!docs/public/cli/
!docs/public/cli/**/*.md
!docs/public/cli/commands/
!docs/public/cli/commands/**/*.md
!docs/public/cli/guides/
!docs/public/cli/guides/**/*.md

# Allow assets and distribution files
!docs/assets/
!docs/assets/**/*
!docs/homebrew/
!docs/homebrew/**/*

# Ignore other directories
.github/instructions/
.github/copilot-instructions.md
.github/copilot-instructions.md.bak
.vscode/
.mcp.json
INITIAL_PROMPT.md
.env
.env.(local|development|production|test)
test_output.txt
.serena/
pexels_api.txt
.venv/

# SECURITY: Watermark receipts contain encryption keys - NEVER commit
*receipt*.md
*receipt*.json
*receipt*.txt
*watermark-receipt*
*-receipt.*
watermark-receipt*
receipt*

# SECURITY: Signing and cryptographic keys - NEVER commit
# Covers: private keys, secret keys, signing keys, key material
keys/
!keys/example/
*signing*.key
*signing*.pem
*private*.key
*private*.pem
*secret*.key
*secret*.pem
watermark*.key
watermark*.pem
*.key
*.pem
!docs/examples/**/*.pem
!tests/testdata/**/*.key

# Go build artifacts
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
bin/
dist/
build/
_build/

# Go test coverage
*.coverprofile
coverage.out
coverage.html
coverage.txt
*.coverage

# Go workspace & dependencies
go.work
go.work.sum

# Air live reload
tmp/
.air.toml

# Delve debugger
__debug_bin

# GoLand
.idea/
*.iml

